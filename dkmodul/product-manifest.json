{
  "schema_version": 1,
  "product": {
    "id": "dolibarr-dk",
    "name": "Dolibarr DK",
    "release": "0.1.0-p0",
    "profile_status": "p0-draft"
  },
  "components": {
    "dolibarr": "24.0.1",
    "dk_module": "0.1.0-p0",
    "php": "8.2.x",
    "database": "MariaDB 11.4.x",
    "saft": "DK SAF-T 2.1",
    "oioubl": "OIOUBL 3 / documentation build 3.2.4.156accde",
    "peppol": "Peppol BIS Billing 3"
  },
  "deployment": {
    "model": "hybrid-customer-hosted",
    "hosting_policy": "customer-selectable-with-deployment-attestation",
    "deployment_attestation": {
      "required": true,
      "schema": "deployment-attestation.schema.json",
      "signature_required": true,
      "signature_algorithms": [
        "RSA-SHA256"
      ],
      "trust_store_schema": "attestation-trust-store.schema.json",
      "trust_store_sha256": "TBD-production-trust-store-sha256",
      "security_risk_evidence": {
        "required": true,
        "schema": "p0-security-risk-evidence.schema.json",
        "signature_required": true,
        "signature_algorithms": [
          "RSA-SHA256"
        ],
        "trust_store_schema": "attestation-trust-store.schema.json",
        "trust_store_sha256": "TBD-production-trust-store-sha256",
        "path_env": "DKMODUL_P0_SECURITY_RISK_EVIDENCE_PATH"
      }
    },
    "backup_policy": {
      "third_party_copy_required": true,
      "eu_eea_copy_required": true,
      "provider_must_be_identified_per_deployment": true
    },
    "access_point": {
      "model": "own-certified-access-point",
      "certification_status": "planned",
      "certification_id": "TBD-production-certification-id",
      "certificate_sha256": "TBD-production-certificate-sha256",
      "valid_from": "TBD",
      "valid_until": "TBD"
    }
  },
  "controls": {
    "full_backup": "weekly-minimum",
    "incremental_backup": "daily-minimum",
    "retention": "five-years-from-financial-year-end",
    "restore_test_required": true,
    "risk_assessment_required": true,
    "processor_agreement_required_where_applicable": true
  },
  "release_signing": {
    "required": true,
    "signature_type": "openssl-rsa-sha256",
    "key_id": "TBD-production-release-key-id",
    "public_key_sha256": "TBD-production-release-public-key-sha256",
    "key_id_env": "DKMODUL_P0_SIGNING_KEY_ID",
    "private_key_path_env": "DKMODUL_P0_SIGNING_PRIVATE_KEY_PATH"
  }
}
