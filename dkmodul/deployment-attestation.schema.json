{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolibarr.dk/schemas/deployment-attestation-v1.json",
  "title": "Dolibarr DK deployment attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "hosting",
    "backup",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "deployment_id": { "type": "string", "minLength": 1 },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "registration_number", "country", "regions"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "registration_number": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "registration_number", "country", "regions", "full_schedule", "incremental_schedule"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "registration_number": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "full_schedule": { "enum": ["daily", "weekly"] },
        "incremental_schedule": { "enum": ["hourly", "daily"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_assessment", "restore_test", "retention_test", "authority_export_test"],
      "properties": {
        "risk_assessment": { "type": "string", "minLength": 1 },
        "restore_test": { "type": "string", "minLength": 1 },
        "retention_test": { "type": "string", "minLength": 1 },
        "authority_export_test": { "type": "string", "minLength": 1 },
        "processor_agreement": { "type": ["string", "null"] }
      }
    }
  }
}
